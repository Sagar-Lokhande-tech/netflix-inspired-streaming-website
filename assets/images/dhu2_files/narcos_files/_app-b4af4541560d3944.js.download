                }
                displayName
            }
            ... on InterstitialDialogComponent {
                text {
                    language
                    value {
                        expandedMarkdown
                        markdown
                        plainText
                        plaidHtml
                    }
                }
                style
            }
        }
        buttons {
            __typename
            label {
                language
                value
            }
            style
            action
        }
    }
